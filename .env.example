# LLM principal (elige uno)
ANTHROPIC_API_KEY=                 # Claude directo
OPENROUTER_API_KEY=                # OpenRouter (acceso a modelos compatibles)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514  # modelo a usar

# LLM local (fallback offline)
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434

# Vision (ya existente)
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash
HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
SCREENSHOT_TIMEOUT_MS=90000

# Servidor web: concurrencia y anti-abuso
MAX_CONCURRENT=2
MAX_QUEUE=10
TRUST_PROXY=false

# Seguridad: contraseña del dashboard (login en el navegador, Bearer para scripts).
# Obligatoria si HOST no es loopback; usa un valor aleatorio de al menos 16 caracteres.
AUTH_TOKEN=

# Red: 0.0.0.0 para abrirlo a la red local o a un hosting
# HOST=127.0.0.1
# RUNS_DIR=./runs
