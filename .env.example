# LLM principal (elige uno)
ANTHROPIC_API_KEY=sk-ant-...       # Claude directo
OPENROUTER_API_KEY=sk-or-...       # OpenRouter (acceso a Gemini, GPT-4, etc.)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514  # modelo a usar

# LLM local (fallback offline)
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434

# Vision (ya existente)
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash
HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
SCREENSHOT_TIMEOUT_MS=90000

# Servidor web: concurrencia y anti-abuso
MAX_CONCURRENT=2
MAX_QUEUE=10
TRUST_PROXY=false

# Seguridad: token opcional para proteger endpoints al exponer el dashboard
# AUTH_TOKEN=your-secret-token
